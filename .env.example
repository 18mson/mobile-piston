NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Gunakan Publishable key baru (sb_publishable_...) atau legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SYNTHETIC_EMAIL_DOMAIN=mobile-piston.local
# Optional Cloudflare Turnstile site key for anti-abuse on auth forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
